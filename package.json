{
  "name": "otp-service",
  "version": "1.0.0",
  "description": "Production-ready multi-channel OTP service supporting email and SMS delivery.",
  "main": "src/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production pm2-runtime ecosystem.config.js",
    "dev": "docker-compose up --build",
    "dev:api": "cross-env NODE_ENV=development nodemon src/server.js",
    "dev:down": "docker-compose down --remove-orphans",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "test:smoke": "cross-env NODE_ENV=test DELIVERY_MODE=mock jest --runInBand",
    "ci": "npm run lint && npm run test:smoke"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.515.0",
    "@aws-sdk/client-sns": "^3.515.0",
    "@sendgrid/mail": "^8.1.0",
    "axios": "^1.6.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.10.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pm2": "^5.3.0",
    "rate-limit-redis": "^4.0.0",
    "twilio": "^4.19.1",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
