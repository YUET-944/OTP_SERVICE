# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
EMAIL_ENABLED=true
SMS_ENABLED=true
DELIVERY_MODE=mock

# Security
OTP_SECRET=replace_with_strong_secret
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRATION=15m
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Rate limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=3600000
EMAIL_RATE_LIMIT_MAX=5
SMS_RATE_LIMIT_MAX=3
IP_RATE_LIMIT_MAX=100
INIT_MAX_RETRIES=5
INIT_RETRY_DELAY_MS=2000
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_DELAY_MS=1000
SMS_MAX_RETRIES=2
SMS_RETRY_DELAY_MS=1000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_TLS_ENABLED=false

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=otp_service
PG_USER=dev
PG_PASSWORD=dev
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=5000

# Admin API
ADMIN_API_KEY=local-admin-key
# Comma-separated list of allowed IPs (optional)
ADMIN_IP_ALLOWLIST=

# Email provider configuration
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=no-reply@example.com
SENDGRID_API_KEY=your_sendgrid_api_key
# Alternative (if using SES)
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# SMS provider configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
# Alternative (if using SNS)
# SMS_PROVIDER=sns
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
